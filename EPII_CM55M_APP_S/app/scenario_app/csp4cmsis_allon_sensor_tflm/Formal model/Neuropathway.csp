-- Neurochannel (csp4cmsis_allon_sensor_tflm): Camera -> Inference -> Reporter.
-- The Reporter is the only process that prints while the network runs; Camera and
-- Inference send it reports over one rendezvous channel with two writers.

MAX_INDEX = 3                                  -- frame indices 0..2 (wrapping), enough to check order

datatype prediction_t = person | no_person
datatype source_t     = camera | inference
datatype report_t     = started.source_t | result.{0..MAX_INDEX-1}.prediction_t

channel g_trigger_chan                         -- frame-ready interrupt -> Camera
channel frame_chan  : {0..MAX_INDEX-1}         -- Camera -> Inference (rendezvous)
channel report_chan : report_t                 -- Camera, Inference -> Reporter (rendezvous, two writers)
channel main_print, camera_log                 -- MainApp's line; the camera driver's start-up log
channel line        : report_t                 -- the Reporter's lines
channel stack_report                           -- the Reporter's periodic stack report

-- The frame-ready interrupt. Camera re-arms the capture only after it has read a trigger,
-- so at most one trigger is pending: the one-slot buffer behaves like a rendezvous here.
ENV = g_trigger_chan -> ENV

-- Camera: the driver prints its start-up log, then Camera reports Started (and never again).
Camera = camera_log -> report_chan!started.camera -> CameraLoop(0)
CameraLoop(c) = g_trigger_chan -> frame_chan!c -> CameraLoop((c + 1) % MAX_INDEX)

-- Inference: initialises the model only after the first frame (i.e. after Camera started),
-- then reports one result per frame. The prediction depends on the image: internal choice.
Inference = frame_chan?f -> report_chan!started.inference -> Infer(f)
Infer(f)  = (report_chan!result.f.person -> Next) |~| (report_chan!result.f.no_person -> Next)
Next      = frame_chan?f -> Infer(f)

-- Reporter: prints every report; after a report it may print the stack report (timer-driven).
Reporter = report_chan?r -> line!r -> ((stack_report -> Reporter) |~| Reporter)

NETWORK = (Camera [| {| frame_chan |} |] Inference) [| {| report_chan |} |] Reporter

-- MainApp runs above the network: it prints its line and ends before any process runs.
SYSTEM = main_print -> (ENV [| {| g_trigger_chan |} |] NETWORK)

-- The console as the user sees it (internal channels hidden).
CONSOLE = SYSTEM \ {| g_trigger_chan, frame_chan, report_chan |}

-- Specification of the console: MainApp's line, the camera driver's log, Camera's and
-- Inference's Started lines, then exactly one result line per frame, in frame order;
-- a stack report may follow any Reporter line.
STK(P) = (stack_report -> P) |~| P
SPEC = main_print -> camera_log -> line!started.camera ->
       STK(line!started.inference -> STK(RESULTS(0)))
RESULTS(f) = |~| p : prediction_t @ line!result.f.p -> STK(RESULTS((f + 1) % MAX_INDEX))

assert SYSTEM :[deadlock free [F]]
assert SYSTEM :[divergence free]
assert SPEC [T= CONSOLE
assert SPEC [F= CONSOLE
assert SPEC [FD= CONSOLE
