-- Uplink (csp4cmsis_neuropathway_image_uplink): the assertions. The processes are in
-- Uplink_defs.csp; Command and cmd_chan are checked in Uplink_command.csp.

include "Uplink_defs.csp"

SYSTEM = SYS(Inference, Reporter, MainApp)

assert SYSTEM :[deadlock free [F]]
assert SYSTEM :[divergence free]

-- The four buffer ids are always a permutation across the roles; Camera is only handed a spare;
-- only the window's best is sent; neither one-slot channel ever overflows.
assert RUN(diff(Events, {error, overflow})) [T= OBSERVED(SYSTEM)

-- The merged count: every Window line carries the number of windows merged since the previous
-- line (saturating at MAXM).
MCOUNT(k) = (merge -> MCOUNT(sat(k + 1)))
            [] (report_chan.window!k -> MCOUNT(0))
            [] (report_chan.wimage!k?b -> MCOUNT(0))

assert MCOUNT(0) [T= SYSTEM \ diff(Events, {| merge, report_chan.window, report_chan.wimage |})

-- The ready token: Inference's reports and the Reporter's token returns alternate, so Inference
-- never writes a report while the Reporter is still busy with its previous one.
INF_REPORTS = {| report_chan.scores, report_chan.window, report_chan.wimage |}
TOKEN = ([] r : INF_REPORTS @ r -> ready_in -> TOKEN)

assert TOKEN [T= SYSTEM \ diff(Events, union(INF_REPORTS, {ready_in}))

-- Camera and Inference keep cycling: the frame-ready trigger is never refused, with the
-- Reporter running and with the Reporter stalled for ever after any report (MainApp's stack
-- reports then block too). Everything but the trigger is hidden and the refinement is
-- failures-divergences, so a refused trigger and any loop of hidden events both fail it; MainApp
-- sends two reports here, since its stack reports would otherwise be such a loop while the
-- Reporter runs (and would hide a blocked Camera: a state on that loop has no refusals).
SYSTEM_STALL = SYS(Inference, ReporterStall, MainApp)

assert SYSTEM_STALL :[deadlock free [F]]
assert CYCLE [FD= SYS(Inference, Reporter, MainAppN(2)) \ diff(Events, {g_trigger_chan})
assert CYCLE [FD= SYS(Inference, ReporterStall, MainAppN(2)) \ diff(Events, {g_trigger_chan})

-- Uplink stalled after the first image (MainApp left out, since it only blocks): from then on
-- only the merges go on, one per window, for ever; no Window line, no image. Before it, Window
-- lines and merges in any order.
ReporterStop = (report_chan?r:INF_TEXT -> line!r -> ready_in -> ReporterStop)
               [] (report_chan?r:OTHER -> line!r -> ReporterStop)
               [] (report_chan.wimage?m?b -> line!window.m -> uplink!b -> STOP)
SYSTEM_STOP = SYS(Inference, ReporterStop, STOP)

STALL_VIEW = {| report_chan.window, report_chan.wimage, uplink, merge |}
PRE        = (merge -> PRE)
             |~| (|~| k : {0..MAXM} @ report_chan.window!k -> PRE)
             |~| (|~| k : {0..MAXM}, b : IDS @ report_chan.wimage!k!b -> ((uplink!b -> STOP) ||| MERGING))
MERGING    = merge -> MERGING

assert PRE [FD= SYSTEM_STOP \ diff(Events, STALL_VIEW)
