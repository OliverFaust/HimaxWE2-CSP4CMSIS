-- Positive controls for Uplink.csp: plausible wrong designs. Each must FAIL its check, showing
-- that the checks of the real model can detect these faults. Each control is the Inference of
-- Uplink_defs.csp with one part changed (the variants are copies with a suffix).

include "Uplink_defs.csp"

-- Control 1 (must break the buffer roles): Camera may be retargeted to the window's best. The
-- release picks from the spares and the best, as if the best buffer were free; Inference still
-- keeps it as the best, so the DMA overwrites the JPEG that may be sent next.
Inference1 = frame_chan?i?p -> report_chan!started.inference -> Infer1(i, p, diff(IDS, {p}), NONE, true, true, 0)

Infer1(i, p, sp, best, tok, rdy, m) =
    (free_out?b -> PollReady1(i, p, union(sp, {b}), best, true, rdy, m))
    [] (poll_empty -> PollReady1(i, p, sp, best, tok, rdy, m))

PollReady1(i, p, sp, best, tok, rdy, m) =
    (ready_out -> Release1(i, p, sp, best, tok, true, m))
    [] (ready_empty -> Release1(i, p, sp, best, tok, rdy, m))

Release1(i, p, sp, best, tok, rdy, m) =
    |~| s : union(sp, if best == NONE then {} else {best}) @
        release_chan!s -> Score1(i, p, diff(sp, {s}), best, tok, rdy, m)

Score1(i, p, sp, best, tok, rdy, m) =
    if best == NONE then
        (scored!failed!p -> End1(i, union(sp, {p}), best, tok, rdy, m))
        |~| (scored!better!p -> End1(i, sp, p, tok, rdy, m))
    else
        (scored!failed!p -> End1(i, union(sp, {p}), best, tok, rdy, m))
        |~| (scored!better!p -> End1(i, union(sp, {best}), p, tok, rdy, m))
        |~| (scored!worse!p -> End1(i, union(sp, {p}), best, tok, rdy, m))

-- The filter (best >= T and at least K frames >= T) depends on the scores, so the model
-- chooses internally between sending and suppressing a window that has a best.
End1(i, sp, best, tok, rdy, m) =
    if rdy then
        if i % W == W - 1 and tok then
            if best == NONE then report_chan!window.m -> Next1(sp, NONE, tok, false, 0)
            else (report_chan!wimage.m.best -> Next1(sp, NONE, false, false, 0))
                 |~| (suppress!best -> report_chan!window.m -> Next1(union(sp, {best}), NONE, tok, false, 0))
        else if i % W == W - 1 then
            merge -> report_chan!scores -> Next1(sp, best, tok, false, sat(m + 1))
        else
            report_chan!scores -> Next1(sp, best, tok, false, m)
    else if i % W == W - 1 then
        merge -> Next1(sp, best, tok, rdy, sat(m + 1))
    else
        Next1(sp, best, tok, rdy, m)

Next1(sp, best, tok, rdy, m) = frame_chan?j?p -> Infer1(j, p, sp, best, tok, rdy, m)


assert RUN(diff(Events, {error, overflow})) [T= OBSERVED(SYS(Inference1, Reporter, MainApp))   -- expected: false

-- Control 2 (must break the buffer roles): Inference sends a Window report with an image when
-- it holds the ready token but not the free token, i.e. before it has read back the buffer of
-- the previous image.
Inference2 = frame_chan?i?p -> report_chan!started.inference -> Infer2(i, p, diff(IDS, {p}), NONE, true, true, 0)

Infer2(i, p, sp, best, tok, rdy, m) =
    (free_out?b -> PollReady2(i, p, union(sp, {b}), best, true, rdy, m))
    [] (poll_empty -> PollReady2(i, p, sp, best, tok, rdy, m))

PollReady2(i, p, sp, best, tok, rdy, m) =
    (ready_out -> Release2(i, p, sp, best, tok, true, m))
    [] (ready_empty -> Release2(i, p, sp, best, tok, rdy, m))

Release2(i, p, sp, best, tok, rdy, m) =
    |~| s : sp @ release_chan!s -> Score2(i, p, diff(sp, {s}), best, tok, rdy, m)

Score2(i, p, sp, best, tok, rdy, m) =
    if best == NONE then
        (scored!failed!p -> End2(i, union(sp, {p}), best, tok, rdy, m))
        |~| (scored!better!p -> End2(i, sp, p, tok, rdy, m))
    else
        (scored!failed!p -> End2(i, union(sp, {p}), best, tok, rdy, m))
        |~| (scored!better!p -> End2(i, union(sp, {best}), p, tok, rdy, m))
        |~| (scored!worse!p -> End2(i, union(sp, {p}), best, tok, rdy, m))

-- The filter (best >= T and at least K frames >= T) depends on the scores, so the model
-- chooses internally between sending and suppressing a window that has a best.
End2(i, sp, best, tok, rdy, m) =
    if rdy then
        if i % W == W - 1 then
            if best == NONE then report_chan!window.m -> Next2(sp, NONE, tok, false, 0)
            else (report_chan!wimage.m.best -> Next2(sp, NONE, false, false, 0))
                 |~| (suppress!best -> report_chan!window.m -> Next2(union(sp, {best}), NONE, tok, false, 0))
        else if i % W == W - 1 then
            merge -> report_chan!scores -> Next2(sp, best, tok, false, sat(m + 1))
        else
            report_chan!scores -> Next2(sp, best, tok, false, m)
    else if i % W == W - 1 then
        merge -> Next2(sp, best, tok, rdy, sat(m + 1))
    else
        Next2(sp, best, tok, rdy, m)

Next2(sp, best, tok, rdy, m) = frame_chan?j?p -> Infer2(j, p, sp, best, tok, rdy, m)


assert RUN(diff(Events, {error, overflow})) [T= OBSERVED(SYS(Inference2, Reporter, MainApp))   -- expected: false

-- Control 4 (must stall Camera when the uplink stalls): Inference writes its Scores report on
-- every frame, whether or not it holds the ready token.
Inference4 = frame_chan?i?p -> report_chan!started.inference -> Infer4(i, p, diff(IDS, {p}), NONE, true, true, 0)

Infer4(i, p, sp, best, tok, rdy, m) =
    (free_out?b -> PollReady4(i, p, union(sp, {b}), best, true, rdy, m))
    [] (poll_empty -> PollReady4(i, p, sp, best, tok, rdy, m))

PollReady4(i, p, sp, best, tok, rdy, m) =
    (ready_out -> Release4(i, p, sp, best, tok, true, m))
    [] (ready_empty -> Release4(i, p, sp, best, tok, rdy, m))

Release4(i, p, sp, best, tok, rdy, m) =
    |~| s : sp @ release_chan!s -> Score4(i, p, diff(sp, {s}), best, tok, rdy, m)

Score4(i, p, sp, best, tok, rdy, m) =
    if best == NONE then
        (scored!failed!p -> End4(i, union(sp, {p}), best, tok, rdy, m))
        |~| (scored!better!p -> End4(i, sp, p, tok, rdy, m))
    else
        (scored!failed!p -> End4(i, union(sp, {p}), best, tok, rdy, m))
        |~| (scored!better!p -> End4(i, union(sp, {best}), p, tok, rdy, m))
        |~| (scored!worse!p -> End4(i, union(sp, {p}), best, tok, rdy, m))

-- The filter (best >= T and at least K frames >= T) depends on the scores, so the model
-- chooses internally between sending and suppressing a window that has a best.
End4(i, sp, best, tok, rdy, m) =
    if rdy then
        if i % W == W - 1 and tok then
            if best == NONE then report_chan!window.m -> Next4(sp, NONE, tok, false, 0)
            else (report_chan!wimage.m.best -> Next4(sp, NONE, false, false, 0))
                 |~| (suppress!best -> report_chan!window.m -> Next4(union(sp, {best}), NONE, tok, false, 0))
        else if i % W == W - 1 then
            merge -> report_chan!scores -> Next4(sp, best, tok, false, sat(m + 1))
        else
            report_chan!scores -> Next4(sp, best, tok, false, m)
    else if i % W == W - 1 then
        merge -> report_chan!scores -> Next4(sp, best, tok, rdy, sat(m + 1))
    else
        report_chan!scores -> Next4(sp, best, tok, rdy, m)

Next4(sp, best, tok, rdy, m) = frame_chan?j?p -> Infer4(j, p, sp, best, tok, rdy, m)


assert CYCLE [FD= SYS(Inference4, ReporterStall, MainAppN(2)) \ diff(Events, {g_trigger_chan})   -- expected: false
